CAT_LABEL = {c["id"]: c["label"] for c in CATEGORIES}


_TAG = re.compile(r"<[^>]+>")


def search_blob(entry):
    """Plain-text haystack the client-side search matches against."""
    parts = [entry["title"], entry["period"], entry.get("summary", ""), entry["band"]]
    parts += entry.get("details", [])
    parts += entry.get("children", [])
    parts += [CAT_LABEL[c] for c in entry["cats"]]
    text = html.unescape(_TAG.sub(" ", " ".join(parts)))
    return " ".join(text.split())


def page_data():
    """Everything the /pseudo_resume template needs, pre-grouped."""
    by_band = [
        (band, [e for e in ENTRIES if e["band"] == band])
        for band in BANDS
    ]
    by_cat = [
        (c, [e for e in ENTRIES if c["id"] in e["cats"]])
        for c in CATEGORIES
    ]
    return {
        "categories": CATEGORIES,
        "cat_label": CAT_LABEL,
        "bands": BANDS,
        "stats": STATS,
        "entries": ENTRIES,
        "by_band": by_band,
        "by_cat": by_cat,
        "total": len(ENTRIES),
    }
